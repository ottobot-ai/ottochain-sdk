{
  "name": "@ottochain/sdk",
  "version": "2.3.0",
  "description": "TypeScript SDK for ottochain metagraph operations - signing, encoding, and network interactions",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./metakit": {
      "import": "./dist/esm/metakit/index.js",
      "require": "./dist/cjs/metakit/index.js",
      "types": "./dist/types/metakit/index.d.ts"
    },
    "./core": {
      "import": "./dist/esm/ottochain/index.js",
      "require": "./dist/cjs/ottochain/index.js",
      "types": "./dist/types/ottochain/index.d.ts"
    },
    "./apps/identity": {
      "import": "./dist/esm/apps/identity/index.js",
      "require": "./dist/cjs/apps/identity/index.js",
      "types": "./dist/types/apps/identity/index.d.ts"
    },
    "./apps/contracts": {
      "import": "./dist/esm/apps/contracts/index.js",
      "require": "./dist/cjs/apps/contracts/index.js",
      "types": "./dist/types/apps/contracts/index.d.ts"
    },
    "./apps/markets": {
      "import": "./dist/esm/apps/markets/index.js",
      "require": "./dist/cjs/apps/markets/index.js",
      "types": "./dist/types/apps/markets/index.d.ts"
    },
    "./apps/oracles": {
      "import": "./dist/esm/apps/oracles/index.js",
      "require": "./dist/cjs/apps/oracles/index.js",
      "types": "./dist/types/apps/oracles/index.d.ts"
    },
    "./apps/governance": {
      "import": "./dist/esm/apps/governance/index.js",
      "require": "./dist/cjs/apps/governance/index.js",
      "types": "./dist/types/apps/governance/index.d.ts"
    },
    "./apps/corporate": {
      "import": "./dist/esm/apps/corporate/index.js",
      "require": "./dist/cjs/apps/corporate/index.js",
      "types": "./dist/types/apps/corporate/index.d.ts"
    },
    "./apps": {
      "import": "./dist/esm/apps/index.js",
      "require": "./dist/cjs/apps/index.js",
      "types": "./dist/types/apps/index.d.ts"
    },
    "./generated": {
      "import": "./dist/esm/generated/index.js",
      "require": "./dist/cjs/generated/index.js",
      "types": "./dist/types/generated/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run prebuild && npm run build:cjs && npm run build:esm && npm run build:types && npm run build:fixup",
    "build:fixup": "echo '{\"type\":\"module\"}' > dist/esm/package.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "generate": "buf generate",
    "lint:proto": "buf lint",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "genesis:manifest": "npm run build && node scripts/emit-genesis-manifest.mjs genesis/std-manifest.json",
    "prepare": "npm run build",
    "prebuild": "node scripts/inline-json.mjs"
  },
  "keywords": [
    "ottochain",
    "constellation",
    "metagraph",
    "dag",
    "ecdsa",
    "secp256k1",
    "signature",
    "rfc8785",
    "canonicalize"
  ],
  "author": "ottochain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ottobot-ai/ottochain-sdk.git"
  },
  "homepage": "https://github.com/ottobot-ai/ottochain-sdk#readme",
  "bugs": {
    "url": "https://github.com/ottobot-ai/ottochain-sdk/issues"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@constellation-network/metagraph-sdk": "^0.2.0",
    "@stardust-collective/dag4": "^2.6.0",
    "@stardust-collective/dag4-keystore": "^2.6.0",
    "canonicalize": "^3.0.0",
    "js-sha256": "^0.11.1",
    "js-sha512": "^0.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.4.1",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "ts-jest": "29.4.9",
    "ts-proto": "^2.11.6",
    "typedoc": "^0.28.19",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@stardust-collective/dag4": "^2.6.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.30.0"
}

{
  "name": "@ottochain/sdk",
  "version": "1.0.2",
  "description": "TypeScript SDK for ottochain metagraph operations - signing, encoding, and network interactions",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./metakit": {
      "import": "./dist/esm/metakit/index.js",
      "require": "./dist/cjs/metakit/index.js",
      "types": "./dist/types/metakit/index.d.ts"
    },
    "./core": {
      "import": "./dist/esm/ottochain/index.js",
      "require": "./dist/cjs/ottochain/index.js",
      "types": "./dist/types/ottochain/index.d.ts"
    },
    "./apps/identity": {
      "import": "./dist/esm/apps/identity/index.js",
      "require": "./dist/cjs/apps/identity/index.js",
      "types": "./dist/types/apps/identity/index.d.ts"
    },
    "./apps/contracts": {
      "import": "./dist/esm/apps/contracts/index.js",
      "require": "./dist/cjs/apps/contracts/index.js",
      "types": "./dist/types/apps/contracts/index.d.ts"
    },
    "./apps/markets": {
      "import": "./dist/esm/apps/markets/index.js",
      "require": "./dist/cjs/apps/markets/index.js",
      "types": "./dist/types/apps/markets/index.d.ts"
    },
    "./apps/oracles": {
      "import": "./dist/esm/apps/oracles/index.js",
      "require": "./dist/cjs/apps/oracles/index.js",
      "types": "./dist/types/apps/oracles/index.d.ts"
    },
    "./apps/governance": {
      "import": "./dist/esm/apps/governance/index.js",
      "require": "./dist/cjs/apps/governance/index.js",
      "types": "./dist/types/apps/governance/index.d.ts"
    },
    "./apps/corporate": {
      "import": "./dist/esm/apps/corporate/index.js",
      "require": "./dist/cjs/apps/corporate/index.js",
      "types": "./dist/types/apps/corporate/index.d.ts"
    },
    "./apps": {
      "import": "./dist/esm/apps/index.js",
      "require": "./dist/cjs/apps/index.js",
      "types": "./dist/types/apps/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types && npm run build:fixup",
    "build:fixup": "echo '{\"type\":\"module\"}' > dist/esm/package.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "generate": "buf generate",
    "lint:proto": "buf lint",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "keywords": [
    "ottochain",
    "constellation",
    "metagraph",
    "dag",
    "ecdsa",
    "secp256k1",
    "signature",
    "rfc8785",
    "canonicalize"
  ],
  "author": "ottochain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ottobot-ai/ottochain-sdk.git"
  },
  "homepage": "https://github.com/ottobot-ai/ottochain-sdk#readme",
  "bugs": {
    "url": "https://github.com/ottobot-ai/ottochain-sdk/issues"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@stardust-collective/dag4": "^2.6.0",
    "@stardust-collective/dag4-keystore": "^2.6.0",
    "canonicalize": "^2.1.0",
    "js-sha256": "^0.11.1",
    "js-sha512": "^0.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.65.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "grpc-tools": "^1.13.1",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-proto": "^2.11.2",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@stardust-collective/dag4": "^2.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}

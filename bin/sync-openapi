#!/usr/bin/env bash
# sync-openapi — refresh the vendored OpenAPI contract and regenerate its TS types.
#
# Usage:
#   bin/sync-openapi
#   bin/sync-openapi --help
#
# Needs GITHUB_TOKEN in the environment: openapi/source.json pins a specific ottochain
# release, and `pnpm fetch:openapi` resolves + downloads it via the GitHub API — a private
# repo or a low unauthenticated rate limit needs a token.
#
#   export GITHUB_TOKEN=$(gh auth token)
#   bin/sync-openapi
#
# What this does:
#   1. pnpm fetch:openapi   — downloads the pinned release's OpenAPI spec(s) into openapi/
#   2. pnpm gen:openapi     — regenerates src/generated/openapi.ts from the vendored spec
#
# After it succeeds, review the diff and commit BOTH the vendored spec and the generated
# types together — CI's typecheck job fails the build if they drift apart:
#   git add openapi src/generated/openapi.ts
#   git commit -m "chore(openapi): sync vendored contract"
#
# To pull a NEWER release rather than re-syncing the current pin, edit openapi/source.json's
# "release" field first (see openapi/README.md), then run this script.
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
  exit 0
fi

if [[ -z "${GITHUB_TOKEN:-}" ]]; then
  echo "WARNING: GITHUB_TOKEN is not set. fetch:openapi may fail with a 404/403 if the" >&2
  echo "         ottochain repo is private or you hit the unauthenticated rate limit." >&2
  echo "         export GITHUB_TOKEN=\$(gh auth token)   # if you have gh authenticated" >&2
  echo >&2
fi

echo "==> pnpm fetch:openapi"
pnpm fetch:openapi

echo
echo "==> pnpm gen:openapi"
pnpm gen:openapi

echo
echo "Done. Review the diff and commit both files together:"
echo "  git status openapi src/generated/openapi.ts"
echo "  git add openapi src/generated/openapi.ts"
echo "  git commit -m \"chore(openapi): sync vendored contract\""
